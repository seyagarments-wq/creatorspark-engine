# Copy to .env (production values) or .env.staging.local (staging values; run `npm run dev -- --mode staging`).
# These are the ONLY two variables the client reads. Both are public by design (compiled into the bundle);
# RLS protects the data. Never put a service role key or any secret here.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
